PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/api-monitor?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d
NODE_ENV=development

# Encryption key for AES-256-GCM credential storage (REQUIRED — 32+ chars)
ENCRYPTION_KEY=your_32_character_encryption_key_here

# Optional Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=API Monitor <your_email@gmail.com>

# CORS
CLIENT_URL=http://localhost:5173

# ── AI Provider Monitoring ────────────────────────────────────────────────────
# AI provider API keys are stored per-user in MongoDB (AES-256-GCM encrypted).
# They are NOT stored in environment variables.
# Users add their own provider credentials through the dashboard UI.
#
# For OpenAI organization-level usage/cost monitoring, users can optionally
# provide an Admin Key in the dashboard (stored encrypted in MongoDB).
# The Admin Key is never returned to the frontend after storage.
#
# No AI provider keys should be added here for a multi-user application.
